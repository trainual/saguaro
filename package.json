{
  "name": "saguaro",
  "private": true,
  "engines": {
    "node": "22.15.1"
  },
  "version": "0.0.0",
  "files": [
    "dist"
  ],
  "main": "./dist/saguaro.umd.js",
  "module": "./dist/saguaro.es.js",
  "types": "./dist/index.d.ts",
  "typings": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/saguaro.es.js",
      "require": "./dist/saguaro.umd.js"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "deploy-storybook": "storybook-to-aws-s3 --bucket-path saguaro-storybook --aws-profile NONE",
    "prepack": "json -f package.json -I -e \"delete this.devDependencies; delete this.dependencies\""
  },
  "dependencies": {
    "parse-url": "^8.1.0",
    "polished": "^4.3.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-is": "^18.2.0",
    "styled-components": "5.3.11"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/addon-interactions": "8.6.14",
    "@storybook/addon-links": "8.6.14",
    "@storybook/addon-themes": "8.6.14",
    "@storybook/blocks": "8.6.14",
    "@storybook/react": "8.6.14",
    "@storybook/react-vite": "8.6.14",
    "@storybook/testing-library": "0.2.2",
    "@swc/plugin-styled-components": "1.5.68",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.1",
    "@types/styled-components": "5.1.34",
    "@typescript-eslint/eslint-plugin": "^8.3.0",
    "@typescript-eslint/parser": "^8.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "eslint-plugin-storybook": "^0.12.0",
    "prop-types": "^15.8.1",
    "storybook": "8.6.14",
    "storybook-dark-mode": "^4.0.1",
    "typescript": "5.3.3",
    "vite": "^5.4.8",
    "vite-plugin-babel-macros": "1.0.6",
    "vite-plugin-dts": "^4.0.3",
    "ws": "^8.17.1"
  },
  "resolutions": {
    "@types/react": "18.3.26",
    "@types/react-dom": "18.3.1"
  }
}
